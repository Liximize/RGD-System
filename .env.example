# Keep your existing .env / environment values. These are placeholders only.
TOKEN=your_discord_bot_token
GUILD_ID=your_server_id

# Existing verification tickets
TICKET_CATEGORY_ID=
PING_ROLE_ID=
LOG_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=

# Existing Twitch alerts
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_STREAMER_NAME=
TWITCH_LIVE_CHANNEL_ID=

# Existing TikTok alerts
TIKTOK_USERS=
TIKTOK_LIVE_CHANNEL_ID=
TIKTOK_CHECK_INTERVAL_SECONDS=60

# New welcome/leave settings; optional, defaults to ./data/settings.json
# DATA_FILE=/persistent/path/settings.json

# Private web dashboard
# Set a long, unique password. The dashboard is disabled when this is blank.
DASHBOARD_PASSWORD=
# Render/Railway normally inject PORT automatically. For local use, defaults to 3000.
# DASHBOARD_PORT=3000
